# Plantilla de configuración. Cópiala como .env y llena tus valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stockpot
DB_USER=stockpot_app
DB_PASSWORD=escribe_aqui_la_clave_de_stockpot_app

# Clave secreta de Flask para firmar sesiones y tokens.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=escribe_aqui_una_clave_larga_y_aleatoria

# Solo si MySQL estuviera en un servidor con otra hora (por ejemplo, en la nube en UTC):
# DB_TIME_ZONE=-05:00

# Opcional: ruta de mysqldump si no esta en la instalacion normal de MySQL (para flask respaldar)
# MYSQLDUMP=C:/Program Files/MySQL/MySQL Server 8.4/bin/mysqldump.exe
